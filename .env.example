# =============================================================================
# Agent Memory SDK — Environment Variable Reference
# =============================================================================
#
# Copy this file to .env (or .env.local) and fill in values for your setup.
# None of these variables are required when using the SQLite backend (the
# default).  Only set what you actually need.
#
# Quick start (SQLite, no config needed):
#   pip install agent-memory-sdk
#   agent-memory remember "hello" "world"
#
# Quick start (Redis):
#   docker compose -f docker-compose.dev.yml up -d redis
#   AGENT_MEMORY_BACKEND=redis AGENT_MEMORY_REDIS_URL=redis://localhost:6379/0
#
# Quick start (Postgres):
#   docker compose -f docker-compose.dev.yml up -d postgres
#   AGENT_MEMORY_BACKEND=postgres AGENT_MEMORY_POSTGRES_DSN=postgresql://agent_memory:agent_memory@localhost:5432/agent_memory
#
# =============================================================================

# =============================================================================
# CORE SETTINGS (apply to all backends)
# =============================================================================

# Directory where SQLite databases / persistent state are written.
# Default: .agent_memory  (relative to the working directory)
AGENT_MEMORY_DIR=.agent_memory

# Collection / table name used inside the store.
# Default: agent_memories
AGENT_MEMORY_COLLECTION=agent_memories

# Storage backend.
# Choices: sqlite (default) | chromadb | redis | postgres
AGENT_MEMORY_BACKEND=sqlite

# =============================================================================
# DECISION THRESHOLDS
# =============================================================================

# Score above which a memory is REPLAYED verbatim (0.0–1.0, default 0.85)
AGENT_MEMORY_REPLAY_THRESHOLD=0.85

# Score above which a memory is RESTORED as context (default 0.70)
AGENT_MEMORY_RESTORE_THRESHOLD=0.70

# Score above which a verify-type memory triggers a VERIFY action (default 0.80)
AGENT_MEMORY_VERIFY_THRESHOLD=0.80

# =============================================================================
# REDIS BACKEND
# =============================================================================

# Redis connection URL  (used when AGENT_MEMORY_BACKEND=redis)
# Format: redis://[password@]host[:port][/db]
AGENT_MEMORY_REDIS_URL=redis://localhost:6379/0

# Optional: separate host/port/db overrides (used if URL is not set)
# AGENT_MEMORY_REDIS_HOST=localhost
# AGENT_MEMORY_REDIS_PORT=6379
# AGENT_MEMORY_REDIS_DB=0
# AGENT_MEMORY_REDIS_PASSWORD=

# Prefix for all Redis keys created by the SDK.
# Useful when sharing a Redis instance between services.
AGENT_MEMORY_REDIS_PREFIX=agent_memory

# docker-compose.dev.yml Redis service port (default 6379)
REDIS_PORT=6379
REDIS_MAX_MEMORY=256mb

# =============================================================================
# POSTGRES BACKEND
# =============================================================================

# PostgreSQL DSN  (used when AGENT_MEMORY_BACKEND=postgres)
# Format: postgresql://user:password@host[:port]/dbname
AGENT_MEMORY_POSTGRES_DSN=postgresql://agent_memory:agent_memory@localhost:5432/agent_memory

# Table name inside the database (default: agent_memories)
# AGENT_MEMORY_POSTGRES_TABLE=agent_memories

# docker-compose.dev.yml Postgres service settings
POSTGRES_PORT=5432
POSTGRES_USER=agent_memory
POSTGRES_PASSWORD=agent_memory
POSTGRES_DB=agent_memory

# =============================================================================
# SEMANTIC / EMBEDDING SEARCH
# =============================================================================

# Enable vector embeddings.
# auto (default) = enable if sqlite-vec + an embedding model are installed.
# true           = require embeddings; fail loudly if unavailable.
# false          = disable even if packages are present.
AGENT_MEMORY_ENABLE_EMBEDDINGS=auto

# =============================================================================
# MCP SERVER
# =============================================================================

# These are read by mcp_server/server.py at startup.
# They follow the same defaults as the core settings above.
# AGENT_MEMORY_DIR=.agent_memory
# AGENT_MEMORY_COLLECTION=agent_memories
# AGENT_MEMORY_BACKEND=sqlite

# =============================================================================
# REST API SERVER  (agent-memory-api)
# =============================================================================

# Host and port for the FastAPI server.
HOST=0.0.0.0
PORT=8000

# =============================================================================
# DEVELOPMENT / CI
# =============================================================================

# Override Postgres DSN for running the Postgres backend tests in CI.
# AGENT_MEMORY_POSTGRES_DSN=postgresql://postgres:postgres@localhost/agent_memory_test
